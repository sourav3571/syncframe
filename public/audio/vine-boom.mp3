<script>
  window.addEventListener('load', function () {
    const featuredImage = document.querySelector('.elementor-widget-featured-image img');
    if (featuredImage) {
      const linkTag = document.createElement('link');
      linkTag.rel = 'preload';
      linkTag.href = featuredImage.src;
      linkTag.as = 'image';
      document.head.appendChild(linkTag);
    }
  });
</script>

